#!/usr/bin/env bash
# One hourly desk cycle: context, mechanical shortlist, LLM veto, execute, exit pass.
set -euo pipefail

_bin_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
_root="$(cd "${_bin_dir}/.." && pwd)"
export TRADING_DESK_LEDGER="${TRADING_DESK_LEDGER:-${_root}/ledger}"
state_dir="${EVOSHELL_STATE:-${XDG_STATE_HOME:-$HOME/.local/state}/evoshell}/trading"
log_file="${state_dir}/desk-cycle.log"
meta_file="${state_dir}/last_run.json"
lock_file="${XDG_RUNTIME_DIR:-/tmp}/evo-trading-desk.lock"
config="${_root}/config.json"

mkdir -p -m 700 "$state_dir"
umask 077

utc_now() { date -u +%Y-%m-%dT%H:%M:%SZ; }

write_meta() {
  local running_flag="${1:-0}" exit_code="${2:-}" err="${3:-}"
  local running_json="false"
  [[ "$running_flag" == "1" ]] && running_json="true"
  jq -cn \
    --arg started_at "${STARTED_AT}" \
    --arg finished_at "${FINISHED_AT:-}" \
    --arg cycle_id "${CYCLE_ID}" \
    --argjson running "$running_json" \
    --arg exit_code "${exit_code:-}" \
    --arg error "${err:-}" \
    '{started_at:$started_at,finished_at:$finished_at,cycle_id:$cycle_id,running:$running,exit_code:$exit_code,error:$error}'
}

STARTED_AT="$(utc_now)"
CYCLE_ID="$STARTED_AT"
FINISHED_AT=""
export STARTED_AT CYCLE_ID

exec 9>"$lock_file"
if ! flock -n 9; then
  echo "desk cycle already running" >&2
  exit 0
fi

write_meta 1 "" "" >"$meta_file"
cd "$_root"
exec >>"$log_file" 2>&1

finish() {
  local rc="$1" err="${2:-}"
  FINISHED_AT="$(utc_now)"
  write_meta 0 "$rc" "$err" >"$meta_file"
  echo "=== done ${CYCLE_ID} rc=${rc} ${err} ==="
  exit "$rc"
}

set +e
echo "=== desk-cycle ${CYCLE_ID} ==="

python3 scripts/desk_context.py >/dev/null || echo "context failed; shortlist marks degraded"

python3 scripts/desk_cycle.py shortlist --cycle-id "$CYCLE_ID"
shortlist_rc=$?

candidates=0
if (( shortlist_rc == 0 )); then
  candidates="$(jq -r '.candidates | length' "${TRADING_DESK_LEDGER}/shortlist.json" 2>/dev/null || echo 0)"
fi

if (( candidates > 0 )); then
  agent_bin=""
  if command -v cursor-agent >/dev/null 2>&1; then
    agent_bin="cursor-agent"
  elif command -v agent >/dev/null 2>&1; then
    agent_bin="agent"
  fi
  if [[ -z "$agent_bin" ]]; then
    echo "cursor-agent not found; no verdicts, no buys"
  else
    vet_model="$(jq -r '.models.vet // empty' "$config")"
    vet_timeout="$(jq -r '.entry.vetTimeoutSeconds // 600' "$config")"
    model_args=()
    [[ -n "$vet_model" && "$vet_model" != "inherit" ]] && model_args=(--model "$vet_model")
    echo "--- desk-vet (${candidates} candidates)"
    /usr/bin/setsid -w /usr/bin/timeout -k 30 "$vet_timeout" \
      "$agent_bin" -p --output-format text "${model_args[@]}" "/desk-vet"
    echo "desk-vet exit $?"
  fi
fi

echo "--- execute"
python3 scripts/desk_cycle.py execute --cycle-id "$CYCLE_ID" \
  | jq -c '{cycle_id,entries_enabled,equity_usd,usd_spot,open_count,scan,vet_pass,vet_reject,sizes,fills,shadow_fills,errors,decisions:[.decisions[]|{pair_id,dollars,reason}]}'
execute_rc=${PIPESTATUS[0]}

echo "--- exit pass"
python3 scripts/desk_exit_check.py | jq -c '{checked,results:[(.results // [])[]|{pair_id,action,rule_fired,pct_vs_entry}]}'

if (( shortlist_rc != 0 )); then
  finish "$shortlist_rc" "shortlist exit $shortlist_rc"
fi
if (( execute_rc != 0 )); then
  finish "$execute_rc" "execute exit $execute_rc"
fi
finish 0
